rules_version = '2';

// Reglas mínimas para lo que existe hoy (Épica 3: Onboarding). Revisión de
// seguridad completa diferida a la Épica 15 (Instrucciones.md §80) — esto
// solo evita que `users/{userId}` quede sin protección (modo prueba/bloqueo
// por defecto de un proyecto de Firebase nuevo) ahora que hay una escritura
// real desde el cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // `aiUsage/{date}` (Épica 5, tarea 5.2 — cuota de IA) es deliberadamente
      // NO matcheado aquí: sin una regla explícita, Firestore deniega por
      // defecto, así que el cliente nunca puede leer ni escribir su propio
      // contador de uso. Solo las Cloud Functions lo tocan (vía Admin SDK,
      // que ignora estas reglas) — es el contador server-trusted, el cliente
      // solo recibe `remainingToday` como parte de la respuesta de la función
      // llamable. No agregar un `match /aiUsage/{date}` con `allow read` sin
      // pensarlo dos veces.

      // `nutritionPlans/{date}` (Épica 6, tarea PLAN-002) — el CONTENIDO del
      // plan (comidas, calorías, macros) solo lo escribe `generateDailyPlan`
      // vía Admin SDK; el cliente solo puede leer, nunca escribir el
      // documento completo. La escritura granular de "comida registrada"
      // (marcar una comida como consumida) queda para PLAN-003, que deberá
      // decidir cómo permitir esa escritura puntual sin abrir la puerta a
      // que el cliente reescriba el contenido generado por la IA.
      match /nutritionPlans/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // `recipes/{recipeId}` (Épica 7) — mismo criterio que `nutritionPlans`:
      // el contenido (ingredientes, pasos, macros) solo lo escribe
      // `generateRecipe` vía Admin SDK; el cliente solo puede leer sus
      // propias recetas, nunca escribirlas.
      match /recipes/{recipeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // `shoppingLists/{weekKey}` (Épica 10) — a diferencia de
      // `nutritionPlans`/`recipes` (contenido generado por la IA), esto es
      // SOLO estado propio del usuario (qué ya marcó como comprado/en casa):
      // el cliente escribe directo, no hay Cloud Function involucrada. Se
      // valida la forma para no dejar guardar campos arbitrarios —
      // `checkedItems` es la única clave permitida, siempre una lista.
      match /shoppingLists/{weekKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['checkedItems'])
          && request.resource.data.checkedItems is list;
      }
    }
  }
}
