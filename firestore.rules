rules_version = '2';

// Épica 15 (Instrucciones.md §80) — primera revisión completa de estas
// reglas desde su versión mínima de la Épica 3.
//
// HALLAZGO Y FIX REAL de esta revisión: el `allow read, write` original de
// `users/{userId}` (sin restricción de campos) permitía al cliente escribir
// CUALQUIER campo del documento — incluyendo uno que las Cloud Functions
// leen como fuente de verdad server-trusted: `subscription.isPremium`
// (`fetchMinimalProfile`/`fetchOnboardingProfile` en `functions/src/ai/` y
// `functions/src/plan/`, Instrucciones.md §70 "DO NOT TRUST CLIENT-SIDE
// PREMIUM STATUS"). Aunque hoy ningún código del cliente escribe ese campo,
// las reglas de Firestore son la única barrera real contra un cliente
// manipulado que sí lo intente directo (Firestore SDK/REST, sin pasar por
// la app) — la ausencia de un `hasOnly()` era el hueco. Épica 13
// (Suscripciones) escribirá `subscription` vía Admin SDK; estas reglas
// están listas para eso sin necesitar otro cambio.
//
// Los únicos campos que el cliente escribe hoy sobre `users/{userId}` (ver
// `onboarding_remote_data_source.dart`/`firebase_notification_preferences_repository.dart`):
// `onboarding`, `onboardingCompletedAt`, `notificationPreferences`. El
// allowlist usa `diff(resource.data).affectedKeys()` en vez de
// `request.resource.data.keys()` — la diferencia importa con
// `SetOptions(merge: true)`: `.keys()` refleja el documento COMPLETO
// resultante (incluyendo campos ya existentes que la escritura ni toca,
// como un futuro `subscription`), así que un `hasOnly` sobre `.keys()` se
// rompería en cuanto exista cualquier campo server-side — `diff().affectedKeys()`
// en cambio solo mira lo que ESTA escritura realmente cambia.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['onboarding', 'onboardingCompletedAt', 'notificationPreferences']);

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onboarding', 'onboardingCompletedAt', 'notificationPreferences']);

      // El cliente nunca borra su propio documento directo — `deleteAccount`
      // (Épica 11, Admin SDK) es el único camino, y el Admin SDK ignora
      // estas reglas de todos modos.
      allow delete: if false;

      // `aiUsage/{date}` (Épica 5, tarea 5.2 — cuota de IA) es deliberadamente
      // NO matcheado aquí: sin una regla explícita, Firestore deniega por
      // defecto, así que el cliente nunca puede leer ni escribir su propio
      // contador de uso. Solo las Cloud Functions lo tocan (vía Admin SDK,
      // que ignora estas reglas) — es el contador server-trusted, el cliente
      // solo recibe `remainingToday` como parte de la respuesta de la función
      // llamable. No agregar un `match /aiUsage/{date}` con `allow read` sin
      // pensarlo dos veces.

      // `nutritionPlans/{date}` (Épica 6, tarea PLAN-002) — el CONTENIDO del
      // plan (comidas, calorías, macros) solo lo escribe `generateDailyPlan`
      // vía Admin SDK; el cliente solo puede leer, nunca escribir el
      // documento completo. La escritura granular de "comida registrada"
      // (marcar una comida como consumida) queda para PLAN-003, que deberá
      // decidir cómo permitir esa escritura puntual sin abrir la puerta a
      // que el cliente reescriba el contenido generado por la IA.
      match /nutritionPlans/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // `recipes/{recipeId}` (Épica 7) — mismo criterio que `nutritionPlans`:
      // el contenido (ingredientes, pasos, macros) solo lo escribe
      // `generateRecipe` vía Admin SDK; el cliente solo puede leer sus
      // propias recetas, nunca escribirlas.
      match /recipes/{recipeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // `notificationPreferences` (Épica 12) — es un campo más del documento
      // `users/{userId}` (no una subcolección aparte), así que ya queda
      // cubierto por el `allow read, write` de arriba sin ninguna regla
      // nueva: mismo criterio que `onboarding`/`updateProfile` (Épica 3/11),
      // preferencia propia del usuario, nunca contenido generado por IA.

      // `shoppingLists/{weekKey}` (Épica 10) — a diferencia de
      // `nutritionPlans`/`recipes` (contenido generado por la IA), esto es
      // SOLO estado propio del usuario (qué ya marcó como comprado/en casa):
      // el cliente escribe directo, no hay Cloud Function involucrada. Se
      // valida la forma para no dejar guardar campos arbitrarios — solo
      // `checkedItems` y `extraItems` (Épica 9: "Añadir X a la lista de
      // compra" desde una receta sugerida), ambas listas, la segunda acotada
      // para que el documento no crezca sin límite. Cualquiera de las dos
      // puede faltar (un `merge` de solo una no escribe la otra).
      match /shoppingLists/{weekKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['checkedItems', 'extraItems'])
          && (!('checkedItems' in request.resource.data) || request.resource.data.checkedItems is list)
          && (!('extraItems' in request.resource.data)
            || (request.resource.data.extraItems is list && request.resource.data.extraItems.size() <= 100));
      }
    }
  }
}
