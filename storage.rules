rules_version = '2';

// Primer uso real de Storage (Épica 8 — Food Photo Analysis). Mismo criterio
// que `firestore.rules`: propiedad explícita por `userId`, y el CONTENIDO
// generado/leído por la IA nunca lo escribe el cliente directamente en
// Firestore — pero la FOTO en sí la sube el cliente (no hay forma de evitarlo,
// los archivos son demasiado grandes para pasarlos por un callable), así que
// aquí sí hay `allow write` real, acotado por tamaño y tipo.
service firebase.storage {
  match /b/{bucket}/o {
    // `foodAnalyses` (Épica 8, `analyzeFoodPhoto`) e `ingredientPhotos`
    // (Épica 9, `suggestRecipesFromIngredients`): las únicas dos carpetas
    // que el cliente puede escribir. Cualquier otra ruta bajo `users/` queda
    // denegada por defecto.
    match /users/{userId}/{folder}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId
        && folder in ['foodAnalyses', 'ingredientPhotos'];

      // Las Cloud Functions leen estos archivos vía Admin SDK, que ignora
      // estas reglas — esto solo gobierna la subida del cliente. 10 MB debe
      // coincidir con `MAX_IMAGE_BYTES` en `functions/src/storage/userPhoto.ts`.
      // Solo tipos de imagen reales (Instrucciones.md §68 "Validate file type").
      allow write: if request.auth != null
        && request.auth.uid == userId
        && folder in ['foodAnalyses', 'ingredientPhotos']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
